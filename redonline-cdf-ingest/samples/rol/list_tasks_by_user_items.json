[
  {
    "id": 186663,
    "title": "Ensure compliance with ADR requirements for consignments of dangerous goods.",
    "description": "Ensure compliance with ADR requirements for consignments of dangerous goods.\n\n- Ascertain that dangerous goods are classified and authorized for carriage according to ADR.\n- Provide the carrier with necessary information, data, and transport documents in a traceable form.\n- Use approved and suitable packagings, large packagings, IBCs, and tanks marked as per ADR.\n- Adhere to dispatch and forwarding restrictions.\n- Ensure empty uncleaned tanks and vehicles are placarded, marked, labelled, closed, and leakproof as if full.\n- For tank-containers and portable tanks with refrigerated liquefied gases, determine the actual holding time or reduce pressure for empty, uncleaned tanks.\n\nComment on frequency:\nReview of current DGSA legal requirements\nReview of any applicable Celanese Tier Two requirements\nReview of any applicable Spondon Tier Three requirements\n\nComment about previous check:\nCheck on the closure progress of the outstanding actions raised in the DGSA audit",
    "type_id": 3,
    "category": 1,
    "priority": 0,
    "recurring_frequency_rule": "YEARLY",
    "recurring_interval_rule": 5,
