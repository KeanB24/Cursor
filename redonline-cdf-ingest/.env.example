# Cognite Data Fusion (OIDC client credentials)
CDF_PROJECT=your-cdf-project
CDF_CLUSTER=westeurope-1
CDF_CLIENT_ID=your-client-id
CDF_CLIENT_SECRET=your-client-secret
CDF_TENANT_ID=your-azure-tenant-id
# Optional override if not using default login.microsoftonline.com
# CDF_TOKEN_URL=https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token

# Red Online REST API
REDONLINE_BASE_URL=https://api.redonline.example.com
REDONLINE_TOKEN=your-bearer-token
# Optional: obtain token via OAuth instead of a static token
# REDONLINE_TOKEN_URL=https://auth.redonline.example.com/oauth/token
# REDONLINE_CLIENT_ID=
# REDONLINE_CLIENT_SECRET=

# Runtime
REDONLINE_MOCK=0
CONFIG_DIR=config
LOG_LEVEL=INFO
