# Cognite Data Fusion (OIDC client credentials)
CDF_PROJECT=celanese
CDF_CLUSTER=az-eastus-1
CDF_CLIENT_ID=your-client-id
CDF_CLIENT_SECRET=your-client-secret
CDF_TENANT_ID=your-azure-tenant-id
# Optional override if not using default login.microsoftonline.com
# CDF_TOKEN_URL=https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token

# HSE Compliance / Red Online REST API (ct-test)
REDONLINE_BASE_URL=https://apigw.ct-test.hse-compliance.net
# Sent as header X-ROL-API-KEY (see config/endpoints.yaml auth)
REDONLINE_API_KEY=9f5ef52b-b98d-4cdb-9672-e423cc9051d5
# Alias also accepted by the client:
# REDONLINE_TOKEN=9f5ef52b-b98d-4cdb-9672-e423cc9051d5

# Optional overrides for path/query placeholders in endpoints.yaml
REDONLINE_SITE_ID=112087
REDONLINE_USER_ID=584646

# Runtime
REDONLINE_MOCK=0
CONFIG_DIR=config
LOG_LEVEL=INFO
